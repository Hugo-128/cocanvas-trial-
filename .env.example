# ===== CoCanvas 环境变量示例 =====
# 用法：复制为 .env 后按需修改（.env 已在 .gitignore，不会入库）
# 不建 .env 也能跑——代码里有同样的默认值

# ws 服务（apps/server）
WS_HOST=127.0.0.1
WS_PORT=7001

# 前端（apps/web，Vite 只暴露 VITE_ 前缀的变量）
VITE_WS_URL=ws://127.0.0.1:7001

# ===== Phase 1 持久化（docker compose 起服务后启用）=====
# DATABASE_URL=postgresql://cocanvas:cocanvas_dev@127.0.0.1:5433/cocanvas
# REDIS_URL=redis://127.0.0.1:6380
